+// Alco: slang emits DXIL for the DX12 backend and MSL for Metal; both go through
+// wgpu-core's generic shader passthrough exactly like the SpirV path above.
+#[no_mangle]
+pub unsafe extern "C" fn wgpuDeviceCreateShaderModuleDxil(
+    device: native::WGPUDevice,
+    descriptor: Option<&native::WGPUShaderModuleDescriptorDxil>,
+) -> native::WGPUShaderModule {
+    let (device_id, context, error_sink) = {
+        let device = device.as_ref().expect("invalid device");
+        (device.id, &device.context, &device.error_sink)
+    };
+    let descriptor = descriptor.expect("invalid descriptor");
+
+    let shader = Cow::Borrowed(make_slice(
+        descriptor.code,
+        descriptor.codeSize as usize,
+    ));
+
+    let desc_label = string_view_into_label(descriptor.label);
+
+    let desc = wgc::pipeline::ShaderModuleDescriptorPassthrough {
+        label: desc_label.to_owned(),
+        dxil: Some(shader),
+        num_workgroups: (
+            descriptor.workgroupSizeX,
+            descriptor.workgroupSizeY,
+            descriptor.workgroupSizeZ,
+        ),
+        ..Default::default()
+    };
+
+    let (shader_module_id, error) =
+        context.device_create_shader_module_passthrough(device_id, &desc, None);
+    if let Some(cause) = error {
+        handle_error(
+            error_sink,
+            cause,
+            desc_label,
+            "wgpuDeviceCreateShaderModuleDxil",
+        );
+    }
+
+    Arc::into_raw(Arc::new(WGPUShaderModuleImpl {
+        context: context.clone(),
+        id: Some(shader_module_id),
+    }))
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn wgpuDeviceCreateShaderModuleMsl(
+    device: native::WGPUDevice,
+    descriptor: Option<&native::WGPUShaderModuleDescriptorMsl>,
+) -> native::WGPUShaderModule {
+    let (device_id, context, error_sink) = {
+        let device = device.as_ref().expect("invalid device");
+        (device.id, &device.context, &device.error_sink)
+    };
+    let descriptor = descriptor.expect("invalid descriptor");
+
+    let shader = match string_view_into_str(descriptor.code) {
+        Some(source) => Cow::Borrowed(source),
+        None => panic!("invalid MSL shader source string view"),
+    };
+
+    let desc_label = string_view_into_label(descriptor.label);
+
+    let desc = wgc::pipeline::ShaderModuleDescriptorPassthrough {
+        label: desc_label.to_owned(),
+        msl: Some(shader),
+        num_workgroups: (
+            descriptor.workgroupSizeX,
+            descriptor.workgroupSizeY,
+            descriptor.workgroupSizeZ,
+        ),
+        ..Default::default()
+    };
+
+    let (shader_module_id, error) =
+        context.device_create_shader_module_passthrough(device_id, &desc, None);
+    if let Some(cause) = error {
+        handle_error(
+            error_sink,
+            cause,
+            desc_label,
+            "wgpuDeviceCreateShaderModuleMsl",
+        );
+    }
+
+    Arc::into_raw(Arc::new(WGPUShaderModuleImpl {
+        context: context.clone(),
+        id: Some(shader_module_id),
+    }))
+}
