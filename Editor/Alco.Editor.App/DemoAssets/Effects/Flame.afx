{
    // A looping flame jet: continuous emission from a small disc, buoyant
    // (upward gravity), shrink-and-fade over life, additive glow.
    "$type": "Alco.Particles.ParticleEffect2DAsset",
    "version": "1.0",
    "groups": [
        {
            "name": "Flame",
            "maxParticles": 2048,
            "looping": true,
            "emissionRate": 400,
            "shape": { "type": "circle", "radius": 1.2 },
            "direction": { "x": 0, "y": 1 },
            "spreadAngle": 0.25,
            "speed": { "min": 8, "max": 16 },
            "lifetime": { "min": 0.5, "max": 1.0 },
            "size": { "min": { "x": 1.8, "y": 1.8 }, "max": { "x": 3.0, "y": 3.0 } },
            "gravity": { "x": 0, "y": 6 },
            "drag": 1.5,
            "startColor": { "min": "#FFBB44FF", "max": "#FF5500FF" },
            "endColor": "#66110000",
            "fadeIn": 0.05,
            "fadeOut": 0.55,
            "endScale": 0.25,
            "texture": "Textures/Glow.png",
            "blend": "Additive"
        },
        {
            // A second emitter of the same effect: sparse bright embers.
            "name": "Embers",
            "maxParticles": 256,
            "looping": true,
            "emissionRate": 25,
            "shape": { "type": "circle", "radius": 1.0 },
            "direction": { "x": 0, "y": 1 },
            "spreadAngle": 0.5,
            "speed": { "min": 14, "max": 26 },
            "lifetime": { "min": 1.2, "max": 2.2 },
            "size": { "min": { "x": 0.3, "y": 0.3 }, "max": { "x": 0.6, "y": 0.6 } },
            "gravity": { "x": 0, "y": 10 },
            "drag": 0.6,
            "startColor": { "min": "#FFEEAAFF", "max": "#FFAA33FF" },
            "endColor": "#44110000",
            "fadeOut": 0.4,
            "texture": "Textures/Star.png",
            "blend": "Additive"
        }
    ]
}
