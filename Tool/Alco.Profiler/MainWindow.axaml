<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Alco.Profiler"
        x:Class="Alco.Profiler.MainWindow"
        x:ClassModifier="internal"
        Title="Alco Profiler — Analysis" Width="1260" Height="840" MinWidth="850" MinHeight="680"
        WindowStartupLocation="CenterScreen" ShowActivated="False"
        Background="{StaticResource ImGuiWindowBrush}" Foreground="{StaticResource ImGuiTextBrush}"
        FontSize="{StaticResource ControlContentThemeFontSize}">
  <Window.Styles>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource ImGuiChildBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource ImGuiMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="ListBox.methods ListBoxItem:nth-child(even)">
      <Setter Property="Background" Value="{StaticResource ImGuiAlternateRowBrush}" />
    </Style>
  </Window.Styles>
  <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="6">
    <Border Classes="panel" Padding="10,6">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Alco Profiler" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Classes="muted caption" Text="Managed sampling · .NET EventPipe" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="TargetLabel" MaxWidth="280" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <Button Grid.Column="2" x:Name="ChooseAppButton" Content="Choose app…" Click="ChooseAppClicked" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="10,0">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="StartButton" Content="Start capture" Click="StartClicked" />
        <Button x:Name="StopButton" Content="Stop capture" Click="StopClicked" />
        <CheckBox x:Name="IncludeAllocationsCheck" Content="Include allocations" VerticalAlignment="Center"
                  ToolTip.Tip="Also sample managed allocations on supported CoreCLR versions. Applies to captures started here or from the overlay." />
        <Button x:Name="ShowOverlayButton" Content="Show overlay" Click="ShowOverlayClicked" />
        <Button x:Name="OpenButton" Content="Open .nettrace…" Click="OpenClicked" />
      </StackPanel>
      <TextBlock Grid.Column="1" x:Name="StatusLabel" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" />
    </Grid>

    <Border Grid.Row="2" Classes="panel" x:Name="HeatmapPanel">
      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <StackPanel Spacing="2">
            <TextBlock Text="Method activity" FontWeight="SemiBold" />
            <TextBlock x:Name="HeatmapSubtitle" Classes="muted caption" Text="Hottest leaf methods · stack samples per slice" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ComboBox x:Name="ThreadPicker" MinWidth="140" SelectionChanged="FilterChanged"
                      AutomationProperties.Name="Thread filter">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:ThreadChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="ScopePicker" SelectedIndex="0" MinWidth="140" SelectionChanged="FilterChanged"
                      AutomationProperties.Name="Stack filter">
              <ComboBoxItem>All stacks</ComboBoxItem>
              <ComboBoxItem>Fixed Tick stacks</ComboBoxItem>
              <ComboBoxItem>Update stacks</ComboBoxItem>
            </ComboBox>
            <Button x:Name="ResetRangeButton" Content="Reset range" Click="ResetRangeClicked" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ComboBox x:Name="MetricPicker" SelectedIndex="0" MinWidth="110" SelectionChanged="FilterChanged"
                      AutomationProperties.Name="Analysis metric">
              <ComboBoxItem>Time</ComboBoxItem>
              <ComboBoxItem x:Name="AllocationMetricItem" IsEnabled="False">Allocation</ComboBoxItem>
            </ComboBox>
            <TextBlock Text="Time slices" VerticalAlignment="Center" />
            <ComboBox x:Name="SlicePicker" SelectedIndex="0" MinWidth="125" SelectionChanged="SliceModeChanged"
                      AutomationProperties.Name="Time slices">
              <ComboBoxItem>Overview</ComboBoxItem>
              <ComboBoxItem>0.5 s</ComboBoxItem>
              <ComboBoxItem>1 s</ComboBoxItem>
              <ComboBoxItem x:Name="TickSlicesItem" IsEnabled="False">Each Tick</ComboBoxItem>
              <ComboBoxItem x:Name="UpdateSlicesItem" IsEnabled="False">Each Update</ComboBoxItem>
            </ComboBox>
          </StackPanel>
          <TextBlock Grid.Column="1" x:Name="SliceHint" Classes="muted caption" TextWrapping="Wrap" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" x:Name="SlicePagePanel" Orientation="Horizontal" Spacing="6"
                      VerticalAlignment="Center" IsVisible="False">
            <Button x:Name="PreviousSlicePageButton" Content="Previous" Click="PreviousSlicePageClicked" />
            <TextBlock x:Name="SlicePageLabel" Classes="muted caption" VerticalAlignment="Center" />
            <Button x:Name="NextSlicePageButton" Content="Next" Click="NextSlicePageClicked" />
          </StackPanel>
        </Grid>
        <local:TraceHeatmapView Grid.Row="2" x:Name="Heatmap" Height="184"
                                AutomationProperties.Name="Method activity heatmap" />
      </Grid>
    </Border>

    <Border Grid.Row="3" Classes="panel" Padding="10,6,10,10">
      <Grid RowDefinitions="Auto,*" RowSpacing="6">
        <TextBlock x:Name="SelectionLabel" Classes="muted caption" Text="No trace loaded" />
        <TabControl Grid.Row="1" x:Name="ResultsTabs">
          <TabItem Header="Flame graph">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <local:FlameGraphView x:Name="FlameGraph" AutomationProperties.Name="Stack sample flame graph" />
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Call tree">
            <TreeView x:Name="CallTree" AutomationProperties.Name="Sampled call tree">
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="local:CallNode" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="muted" Text="{Binding TotalLabel}" />
                    <TextBlock Text="{Binding Method}" ToolTip.Tip="{Binding Method}" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </TabItem>
          <TabItem Header="Methods">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="SearchBox" Watermark="Filter by method name" TextChanged="MethodFilterChanged"
                         AutomationProperties.Name="Find method" />
                <ComboBox Grid.Column="1" x:Name="SortPicker" SelectedIndex="0" SelectionChanged="MethodFilterChanged"
                          AutomationProperties.Name="Method sort order">
                  <ComboBoxItem>Sort by total</ComboBoxItem>
                  <ComboBoxItem>Sort by self</ComboBoxItem>
                </ComboBox>
              </Grid>
              <Border Grid.Row="1" Background="{StaticResource ImGuiFrameBrush}" CornerRadius="4" Padding="4,4,12,4">
                <Grid ColumnDefinitions="*,104,104,144" ColumnSpacing="8">
                  <TextBlock Text="Method" />
                  <TextBlock Grid.Column="1" x:Name="TotalCostHeader" Text="Total ≈ ms" TextAlignment="Right" />
                  <TextBlock Grid.Column="2" x:Name="SelfCostHeader" Text="Self ≈ ms" TextAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="Samples (total / self)" TextAlignment="Right" />
                </Grid>
              </Border>
              <ListBox Grid.Row="2" x:Name="MethodsList" Classes="methods" Background="Transparent"
                       AutomationProperties.Name="Sampled methods">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MethodSummary">
                    <Grid ColumnDefinitions="*,104,104,144" ColumnSpacing="8">
                      <TextBlock Text="{Binding Method}" ToolTip.Tip="{Binding Method}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding TotalLabel}" TextAlignment="Right" />
                      <TextBlock Grid.Column="2" Text="{Binding SelfLabel}" TextAlignment="Right" />
                      <TextBlock Grid.Column="3" Text="{Binding SampleCounts}" TextAlignment="Right" Classes="muted" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
          <TabItem x:Name="AllocationTypesTab" Header="Object types" IsVisible="False">
            <Grid RowDefinitions="Auto,*" Margin="0,6,0,0">
              <Border Padding="8,4" Background="{StaticResource ImGuiChildBrush}">
                <Grid ColumnDefinitions="*,160,104" ColumnSpacing="8">
                  <TextBlock Text="Managed type" />
                  <TextBlock Grid.Column="1" Text="Estimated allocation" TextAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="Samples" TextAlignment="Right" />
                </Grid>
              </Border>
              <ListBox Grid.Row="1" x:Name="AllocationTypesList" Classes="methods" Background="Transparent"
                       AutomationProperties.Name="Sampled allocation types">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:AllocationTypeSummary">
                    <Grid ColumnDefinitions="*,160,104" ColumnSpacing="8">
                      <TextBlock Text="{Binding TypeName}" ToolTip.Tip="{Binding TypeName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding CostLabel}" TextAlignment="Right" />
                      <TextBlock Grid.Column="2" Text="{Binding Cost.Samples, StringFormat='{}{0:N0}'}" TextAlignment="Right" Classes="muted" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
    </Border>

    <StackPanel Grid.Row="4" Margin="10,0" Spacing="3">
      <TextBlock Classes="muted caption" TextWrapping="Wrap"
                 Text="Method times and managed allocation bytes are sampling estimates. Tick / Update slices use recorded boundaries; stack filters match call ancestry." />
      <SelectableTextBlock x:Name="TracePathLabel" FontSize="14" Foreground="{StaticResource ImGuiMutedBrush}" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
