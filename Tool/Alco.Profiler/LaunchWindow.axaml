<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Alco.Profiler.LaunchWindow" x:ClassModifier="internal"
        Title="Alco Profiler" Width="660" MinWidth="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" CanResize="False"
        Background="{StaticResource ImGuiWindowBrush}" Foreground="{StaticResource ImGuiTextBrush}"
        FontSize="{StaticResource ControlContentThemeFontSize}">
  <Border Margin="10" Padding="12" CornerRadius="6" Background="{StaticResource ImGuiChildBrush}">
    <StackPanel Spacing="8">
      <TextBlock Text="Choose an application" FontSize="18" FontWeight="SemiBold" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox x:Name="TargetPathBox" IsReadOnly="True" Watermark="Executable, .csproj, .sln or .slnx"
                 AutomationProperties.Name="Application path" />
        <Button Grid.Column="1" x:Name="BrowseButton" Content="Browse…" Click="BrowseClicked" />
      </Grid>
      <StackPanel x:Name="ProjectPanel" Spacing="4" IsVisible="False">
        <TextBlock Text="Startup project" Foreground="{StaticResource ImGuiMutedBrush}" FontSize="14" />
        <ComboBox x:Name="ProjectPicker" HorizontalAlignment="Stretch" PlaceholderText="Choose a runnable C# project"
                  AutomationProperties.Name="Startup project" />
      </StackPanel>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock x:Name="LaunchStatus" VerticalAlignment="Center" Foreground="{StaticResource ImGuiMutedBrush}"
                   FontSize="14" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="5" />
        <Button Grid.Column="1" x:Name="LaunchButton" Content="Launch" Click="LaunchClicked" VerticalAlignment="Center" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
