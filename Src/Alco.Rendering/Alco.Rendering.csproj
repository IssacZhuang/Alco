<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAssetsPack>false</UseAssetsPack>
    <DefineConstants>STBSHARP_INTERNAL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Alco\Alco.csproj" />
    <ProjectReference Include="..\Alco.Graphics\Alco.Graphics.csproj" />
    <ProjectReference Include="..\Alco.IO\Alco.IO.csproj" />
    <PackageReference Include="SharpAstro.Fonts" Version="2.0.1171" />
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />

  </ItemGroup>
   <ItemGroup>
    <EmbeddedResource Include="Assets\Shaders\Libs\AlcoRendering_Bloom.slang" LogicalName="AlcoRendering_Bloom.slang" />
    <EmbeddedResource Include="Assets\Shaders\Libs\AlcoRendering_FXAA.slang" LogicalName="AlcoRendering_FXAA.slang" />
    <EmbeddedResource Include="Assets\Shaders\Libs\AlcoRendering_MeshScene3D.slang" LogicalName="AlcoRendering_MeshScene3D.slang" />
    <EmbeddedResource Include="Assets\Shaders\Libs\AlcoRendering_Sprite2D.slang" LogicalName="AlcoRendering_Sprite2D.slang" />
    <EmbeddedResource Include="Assets\Shaders\Libs\AlcoRendering_SpriteScene.slang" LogicalName="AlcoRendering_SpriteScene.slang" />
    <EmbeddedResource Include="Assets\Shaders\Libs\AlcoRendering_TextureCompression.slang" LogicalName="AlcoRendering_TextureCompression.slang" />
    <EmbeddedResource Include="Assets\Shaders\Libs\AlcoRendering_TextureCompressionBc7.slang" LogicalName="AlcoRendering_TextureCompressionBc7.slang" />
    <EmbeddedResource Include="Assets\Shaders\Libs\AlcoRendering_TextureCompressionLegacy.slang" LogicalName="AlcoRendering_TextureCompressionLegacy.slang" />
    <EmbeddedResource Include="Assets\Shaders\Libs\AlcoRendering_Tonemap.slang" LogicalName="AlcoRendering_Tonemap.slang" />
    <EmbeddedResource Include="Assets\Shaders\Materials\MeshScene3DSurface*.slang" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Shaders\Materials\SpriteSceneSurface*.slang" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Shaders\Passes\Compute\Compress\*.slang" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Shaders\Passes\Compute\GpuInstanceScatter.slang" LogicalName="GpuInstanceScatter.slang" />
    <EmbeddedResource Include="Assets\Shaders\Passes\Compute\MeshScene3D*.slang" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Shaders\Passes\Compute\SpriteScene*.slang" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Shaders\Passes\Compute\SvgRasterize.slang" LogicalName="SvgRasterize.slang" />
    <EmbeddedResource Include="Assets\Shaders\Passes\PostFX\Bloom\*.slang" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Shaders\Passes\PostFX\FXAA\*.slang" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Shaders\Passes\PostFX\Tonemap\*.slang" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Shaders\Passes\Scene\MeshScene3DPass.slang" LogicalName="MeshScene3DPass.slang" />
    <EmbeddedResource Include="Assets\Shaders\Passes\Scene\Sprite2DDefault.slang" LogicalName="Sprite2DDefault.slang" />
    <EmbeddedResource Include="Assets\Shaders\Passes\Scene\Sprite2DPass.slang" LogicalName="Sprite2DPass.slang" />
    <EmbeddedResource Include="Assets\Shaders\Passes\Scene\SpriteScenePass.slang" LogicalName="SpriteScenePass.slang" />
    <Content
      Condition="'$(UseAssetsPack)' == 'false'"
      Include="$(MSBuildThisFileDirectory)/Assets/**/*.*">
      <Link>Assets/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
