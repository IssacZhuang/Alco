// Tonemap chain-transform node. Operator and 8-bit dither mode are generic value
// specializations of TonemapCompute / TonemapGraphics.
{
    "$type": "Alco.Rendering.RGNodeFactory_Tonemap",
    "descriptor": {
        "computeShader": "TonemapCompute",
        "graphicsShader": "TonemapGraphics",
        "operator": "Neutral",
        "ditherEnabled": true
    }
}
