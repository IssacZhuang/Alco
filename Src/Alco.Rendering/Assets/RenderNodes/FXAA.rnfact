// FXAA anti-aliasing chain-transform node. Quality, mode, and color space are
// generic value specializations of FXAACompute / FXAAGraphics.
{
    "$type": "Alco.Rendering.RGNodeFactory_FXAA",
    "descriptor": {
        "computeShader": "FXAACompute",
        "graphicsShader": "FXAAGraphics",
        "quality": "Medium",
        "mode": "Luma",
        "colorSpace": "Gamma",
        "threshold": 0.125,
        "thresholdMin": 0.0312,
        "subpix": 0.75,
        "depthThresholdMin": 0.000244140625,
        "depthThresholdRel": 0.015625,
        "colorVisibilityFloor": 0.015625
    }
}
