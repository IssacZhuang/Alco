// Volumetric clouds render plugin node. The noise-bake specializations are the
// generic value variants of one module (MainCS<let IsDetail>: 0 = base shape,
// 1 = detail); wiring happens in code through RGNode_VolumetricClouds.Attach.
{
    "$type": "Alco.World3D.RGNodeFactory_VolumetricClouds",
    "descriptor": {
        "marchShader": "volumetric-clouds",
        "compositeShader": "volumetric-clouds-composite",
        "shadowShader": "volumetric-cloud-shadow",
        "noiseBaseShader": { "module": "volumetric-cloud-noise", "specialization": 0 },
        "noiseDetailShader": { "module": "volumetric-cloud-noise", "specialization": 1 },
        "marchResolutionScale": 0.5
    }
}
