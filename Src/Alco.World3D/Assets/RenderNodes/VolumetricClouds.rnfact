// Volumetric clouds render plugin node. The noise-bake specializations resolve
// inside the node; wiring happens in code through RGNode_VolumetricClouds.Attach.
{
    "$type": "Alco.World3D.RGNodeFactory_VolumetricClouds",
    "descriptor": {
        "marchShader": "volumetric-clouds",
        "compositeShader": "volumetric-clouds-composite",
        "shadowShader": "volumetric-cloud-shadow",
        "marchResolutionScale": 0.5
    }
}
