// Screen-space reflections render plugin node. The deferred inputs (G-buffer,
// scene color, voxel GI node, camera, environment, post chain) are registered
// on the factory context services by the composing code; graph insertion
// happens in code through RGNode_SSR.Attach.
{
    "$type": "Alco.World3D.RGNodeFactory_SSR",
    "descriptor": {
        "traceShader": "screen-space-reflection-trace",
        "resolveShader": "screen-space-reflection-resolve",
        "compositeShader": "screen-space-reflection-composite",
        "blitShader": "blit",
        "blueNoiseShader": "screen-space-reflection-blue-noise",
        "traceResolutionScale": 0.5
    }
}
