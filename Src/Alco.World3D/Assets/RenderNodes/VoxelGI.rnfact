// Voxel global illumination render plugin node. The voxelize feed composes per
// material surface through the material compiler (a factory context service)
// from the descriptor's template; graph wiring happens in code through
// RGNode_VoxelGI.Attach.
{
    "$type": "Alco.World3D.RGNodeFactory_VoxelGI",
    "descriptor": {
        "clear": "voxel-clear",
        "inject": "voxel-inject",
        "mip": "voxel-mip",
        "mipChain": "voxel-mip-chain",
        "propagate": "voxel-propagate",
        "trace": "voxel-trace",
        "demosaic": "voxel-demosaic",
        "blueNoise": "screen-space-reflection-blue-noise",
        "voxelizeTemplate": "voxelize",
        "upsample": "voxel-gi-upsample",
        "resolution": 128,
        "baseVoxelSize": 0.25,
        "traceResolutionScale": 0.5
    }
}
