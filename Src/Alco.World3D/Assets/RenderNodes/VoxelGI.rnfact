// Voxel global illumination render plugin node. The voxelize feed composes per
// material surface through the material compiler (a factory context service);
// graph wiring happens in code through RGNode_VoxelGI.Attach.
{
    "$type": "Alco.World3D.RGNodeFactory_VoxelGI",
    "clearShader": "voxel-clear",
    "injectShader": "voxel-inject",
    "mipShader": "voxel-mip",
    "mipChainShader": "voxel-mip-chain",
    "propagateShader": "voxel-propagate",
    "traceShader": "voxel-trace",
    "demosaicShader": "voxel-demosaic",
    "blueNoiseShader": "screen-space-reflection-blue-noise",
    "upsampleShader": "voxel-gi-upsample",
    "resolution": 128,
    "baseVoxelSize": 0.25,
    "traceResolutionScale": 0.5
}
