<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Alco.World3D</RootNamespace>
    <AssemblyName>Alco.World3D</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alco.Rendering\Alco.Rendering.csproj" />
    <ProjectReference Include="..\Alco.IO\Alco.IO.csproj" />
    <InternalsVisibleTo Include="$(AssemblyName).Test" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pre-migration pipeline remains on disk until its passes and loaders are replaced. -->
    <Compile Remove="AssetPipeline\**\*.cs;Rendering\**\*.cs" />
    <Compile Include="Rendering\Deferred\VoxelGiClipmap.cs;Rendering\Sky\ProceduralSkyUtility.cs;Rendering\World3DRenderPipeline.cs;Rendering\World3DDrawLayout.cs;Rendering\World3DGeometryPasses.cs;Rendering\World3DGBufferPrograms.cs;Rendering\World3DDeferredLighting.cs;Rendering\World3DShadowTypes.cs;Rendering\World3DOcclusion.cs;Rendering\World3DShadows.cs;Rendering\World3DFarShadow.cs;Rendering\World3DVoxelGiTypes.cs;Rendering\World3DVoxelClipmap.cs;Rendering\World3DVoxelGi.cs" />
    <EmbeddedResource Include="Scene\World3DSceneData.slang" LogicalName="World3DSceneData.slang" />
    <EmbeddedResource Include="Assets\Shaders\Phase1\*.slang" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Shaders\Phase2\*.slang" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Shaders\Phase3\*.slang" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)Assets\**\*.*">
      <Link>Assets/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
