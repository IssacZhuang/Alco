<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Alco.World3D</RootNamespace>
    <AssemblyName>Alco.World3D</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alco.Rendering\Alco.Rendering.csproj" />
    <ProjectReference Include="..\Alco.IO\Alco.IO.csproj" />
    <InternalsVisibleTo Include="$(AssemblyName).Test" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pre-migration pipeline remains on disk until its passes and loaders are replaced. -->
    <Compile Remove="AssetPipeline\**\*.cs;Rendering\**\*.cs" />
    <Compile Include="Rendering\Deferred\VoxelGiClipmap.cs;Rendering\World3DRenderPipeline.cs" />
    <EmbeddedResource Include="Scene\World3DSceneData.slang" LogicalName="World3DSceneData.slang" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)Assets\**\*.*">
      <Link>Assets/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
