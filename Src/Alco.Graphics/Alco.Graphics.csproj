<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS1591;CS1701</NoWarn>
    <Description>Alco graphics abstraction, backends (Vulkan, VulkanCompact, D3D12, Metal, NoGPU), bindings, Slang compiler, and high-level rendering runtime</Description>
  </PropertyGroup>

  <PropertyGroup>
    <_SlangRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_SlangRid>
    <_SlangRid Condition="'$(_SlangRid)' == '' and '$(NETCoreSdkRuntimeIdentifier)' != ''">$(NETCoreSdkRuntimeIdentifier)</_SlangRid>
    <_SlangRid Condition="'$(_SlangRid)' == ''">win-x64</_SlangRid>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Shaders\NoGraphicsAPI\shader.slang" LogicalName="NoGraphicsAPI/shader.slang" />
    <EmbeddedResource Include="Shaders\NoGraphicsAPI.slang" LogicalName="NoGraphicsAPI.slang" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Shaders\NoGraphicsRendering\samplers.slang" Link="NoGraphicsRendering\samplers.slang" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="runtimes/$(_SlangRid)/native/*" Condition="Exists('runtimes/$(_SlangRid)/native')">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Pack>true</Pack>
      <PackagePath>runtimes/$(_SlangRid)/native/</PackagePath>
      <Visible>False</Visible>
    </Content>
  </ItemGroup>

</Project>
