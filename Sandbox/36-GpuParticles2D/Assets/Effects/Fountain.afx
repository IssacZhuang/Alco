{
    // A looping fountain: a narrow upward jet under strong gravity, plus a
    // periodic burst every loop of the 2-second timeline.
    "$type": "Alco.Particles.ParticleEffect2DAsset",
    "version": "1.0",
    "groups": [
        {
            "name": "Jet",
            "maxParticles": 4096,
            "looping": true,
            "duration": 2.0,
            "emissionRate": 600,
            "bursts": [ { "time": 1.0, "countMin": 150, "countMax": 200 } ],
            "shape": { "type": "point" },
            "direction": { "x": 0, "y": 1 },
            "spreadAngle": 0.12,
            "speed": { "min": 28, "max": 38 },
            "lifetime": { "min": 1.2, "max": 1.8 },
            "size": { "min": { "x": 0.5, "y": 0.5 }, "max": { "x": 1.0, "y": 1.0 } },
            "angularVelocity": { "min": -4, "max": 4 },
            "gravity": { "x": 0, "y": -35 },
            "startColor": { "min": "#3388FFFF", "max": "#66CCFFFF" },
            "endColor": "#11335500",
            "fadeOut": 0.35,
            "endScale": 0.6,
            "texture": "Glow",
            "blend": "Additive"
        }
    ]
}
